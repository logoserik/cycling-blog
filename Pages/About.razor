@page "/about"

<div class="nes-container with-title">
    <p class="title pixel-title">About Ride Log</p>
    <div class="nes-text">
        <p>
            This is a small cycling blog built with <b>Blazor WebAssembly (.NET 10)</b>.
            The writing lives as <b>Markdown</b> in GitHub, edited with <b>Sveltia CMS</b>.
        </p>
        <p>
            Publish a post in the admin UI, GitHub Actions rebuilds the site, then the ride
            appears here.
        </p>
    </div>
</div>
